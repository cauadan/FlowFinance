# PostgreSQL pooled connection URL (used by Prisma Client for app queries)
DATABASE_URL="postgresql://user:password@localhost:5432/flowfinance?pgbouncer=true"

# PostgreSQL direct connection URL (used by Prisma for migrations and schema pushing)
DIRECT_URL="postgresql://user:password@localhost:5432/flowfinance"

# API server port (default: 3001)
PORT=3001

# Directory path for storing database backups (default: ./backups)
BACKUP_PATH="./backups"

# Secret key for signing JWT tokens (use a long random string)
JWT_SECRET="CHANGE_ME_to_a_long_random_secret_string"

# Google Gemini API key for the financial assistant (get one at https://aistudio.google.com/apikey)
GEMINI_API_KEY="your_gemini_api_key_here"
